<%- include('../partials/header') %><a class="back" href="/subjects/<%= subject.id %>">← Volver a <%= subject.name %></a><div class="eyebrow"><%= subject.name %></div><h1><%= title %></h1><p class="lead">Registra la evaluación y agrega observaciones si lo necesitas.</p><section class="panel form"><% if(errors.length){ %><div class="error" role="alert"><% errors.forEach(e=>{ %><div><%= e %></div><% }) %></div><% } %><form method="post" action="/subjects/<%= subject.id %>/activities<%= activity.id?'/'+activity.id+'/update':'' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="fields"><div class="field full"><label for="title">Título de la actividad</label><input id="title" name="title" required maxlength="150" value="<%= activity.title||'' %>"></div><div class="field"><label for="type">Tipo de actividad</label><select id="type" name="type" required><option value="">Seleccionar tipo</option><% Object.entries(types).forEach(([key,label])=>{ %><option value="<%= key %>" <%= activity.type===key?'selected':'' %>><%= label %></option><% }) %></select></div><div class="field"><label for="grade">Calificación (0–100)</label><input id="grade" name="grade" type="number" required min="0" max="100" step="0.01" value="<%= activity.grade??'' %>"></div><div class="field"><label for="date">Fecha</label><input id="date" name="date" type="date" required min="1000-01-01" max="9999-12-31" value="<%= activity.date||'' %>"></div><div class="field full"><label for="notes">Observaciones (opcional)</label><textarea id="notes" name="notes" maxlength="8000"><%= activity.notes||'' %></textarea></div></div><div class="actions"><button type="submit"><%= activity.id?'Guardar cambios':'Guardar actividad' %></button><a href="/subjects/<%= subject.id %>">Cancelar</a></div></form></section><%- include('../partials/footer') %>

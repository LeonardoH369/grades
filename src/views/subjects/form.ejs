<%- include('../partials/header') %><a class="back" href="/subjects">← Volver a materias</a><div class="eyebrow">Mi semestre</div><h1><%= title %></h1><p class="lead">Asigna un nombre para organizar sus evaluaciones.</p><section class="panel form"><% if(errors.length){ %><div class="error" role="alert"><%= errors.join(' ') %></div><% } %><form method="post" action="<%= subject.id?'/subjects/'+subject.id+'/update':'/subjects' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field"><label for="name">Nombre de la materia</label><input id="name" name="name" required maxlength="120" value="<%= subject.name||'' %>"></div><div class="actions"><button type="submit"><%= subject.id?'Guardar cambios':'Agregar materia' %></button><a href="/subjects">Cancelar</a></div></form></section><%- include('../partials/footer') %>

<%- include('../partials/header') %><a class="back" href="/subjects">← Volver a materias</a><div class="eyebrow">Detalle de materia</div><div class="toolbar"><div><h1><%= subject.name %></h1><p class="muted"><%= activities.length %> actividades registradas · Escala de 0 a 100</p></div><a class="button" href="/subjects/<%= subject.id %>/activities/create">+ Nueva actividad</a></div><section class="panel"><% if(activities.length){ %><table><thead><tr><th>Actividad</th><th>Tipo</th><th>Calificación</th><th>Fecha</th><th>Acciones</th></tr></thead><tbody><% activities.forEach(activity=>{ %><tr><td><strong><%= activity.title %></strong><% if(activity.notes){ %><p class="muted"><%= activity.notes %></p><% } %></td><td><span class="badge"><%= types[activity.type] %></span></td><td><strong><%= Number(activity.grade).toFixed(2) %></strong></td><td><%= activity.date %></td><td><div class="actions"><a href="/subjects/<%= subject.id %>/activities/<%= activity.id %>/edit">Editar</a><a class="danger-link" href="/subjects/<%= subject.id %>/activities/<%= activity.id %>/delete">Eliminar</a></div></td></tr><% }) %></tbody></table><% }else{ %><div class="empty"><h2>Aún no hay evaluaciones</h2><p>Registra una tarea, examen o proyecto.</p></div><% } %></section><%- include('../partials/footer') %>

<%- include('../partials/header') %><div class="eyebrow">Organización académica</div><div class="toolbar"><div><h1>Mis materias</h1><p class="muted">Consulta tus avances y registra cada evaluación.</p></div><a class="button" href="/subjects/create">+ Agregar materia</a></div><div class="grid"><% subjects.forEach(subject=>{ const total=subject.activities.length;const avg=total?subject.activities.reduce((sum,x)=>sum+Number(x.grade),0)/total:null; %><article class="panel"><span class="badge"><%= total %> evaluaciones</span><h2><a href="/subjects/<%= subject.id %>"><%= subject.name %></a></h2><div class="stat"><%= avg===null?'—':avg.toFixed(1) %><small class="muted"> /100</small></div><p class="muted">Promedio simple de actividades</p><div class="actions"><a href="/subjects/<%= subject.id %>">Ver actividades</a><a href="/subjects/<%= subject.id %>/edit">Editar</a><a class="danger-link" href="/subjects/<%= subject.id %>/delete">Eliminar</a></div></article><% }) %></div><% if(!subjects.length){ %><section class="panel empty"><h2>Tu semestre comienza aquí</h2><p>Agrega una materia para registrar sus actividades.</p></section><% } %><%- include('../partials/footer') %>
